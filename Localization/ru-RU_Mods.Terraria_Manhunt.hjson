InfoDisplays.TrackerInfoDisplay.DisplayName: Информация о цели

Configs: {
	TerrariaManhuntSettings: {
		DisplayName: Настройки Terraria Manhunt

		Headers: {
			Visuals: Визуал
			Damage: Урон
			Miscellaneous: Прочее
		}

		HidePlayers: {
			Label: "[i:264] [c/32FF82:Скрывать иконки игроков на карте]"
			Tooltip:
				'''
				Иконки игроков из других команд будут скрыты на карте.
				Вкл: Вражеские иконки скрыты.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		HideHealthBars: {
			Label: "[i:29] [c/32FF82:Скрывать здоровье игроков]"
			Tooltip:
				'''
				Также влияет на игроков из своей команды.
				Вкл: Здоровье других игроков скрыто.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		HideDeathMarkers: {
			Label: "[i:1175] [c/32FF82:Скрывать места смерти]"
			Tooltip:
				'''
				Скрывает только места смерти игроков из других команд.
				Вкл: Вражеские места смерти скрыты.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		HideNPCs: {
			Label: "[i:867] [c/32FF82:Скрывать иконки НИПов]"
			Tooltip:
				'''
				Чтобы местоположение НИПов не знал весь мир.
				Вкл: Все НИПы полностью спрятаны с карты.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		AnnounceAchievements: {
			Label: "[i:4084] [c/32FF82:Объявлять о достижениях]"
			Tooltip:
				'''
				Получаемые игроками достижения будут публиковаться в чате.
				(Также будет сбрасывать достижения каждую сессию)
				Вкл: Сообщения о достижениях отправляются всем.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		ForcePvP: {
			Label: "[i:4] [c/FF1919:Всегда PvP]"
			Tooltip:
				'''
				У всех игроков будет сразу включен PvP.
				Вкл: PvP вечно включён.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		HurtNPCs: {
			Label: "[i:5095] [c/FF1919:Всем НИПам можно наносить урон] [c/327DFF:(кроме Гида)]"
			Tooltip:
				'''
				Чтобы медсестра не была имбой.
				Вкл: Все городские НИПы могут получать урон от игроков.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		FriendlyFire: {
			Label: "[i:795] [c/FF1919:Дружеский огонь]"
			Tooltip:
				'''
				Игроки из вашей команды, стоящие на пути вашего снаряда, получат свою долю.
				Вкл: Игроки из одной команды смогут наносить друг другу урон
				Выкл: Применяются стандартные правила игры.
				'''
		}

		MasterDrops: {
			Label: "[i:3322] [c/FF1919:Выпадение предметов Мастер-сложности]"
			Tooltip:
				'''
				Позволяет предметам Мастер-сложности выпадать даже в мирах обычной сложности.
				Вкл: Предметы Мастер-сложности выпадают.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		DisableTelePot: {
			Label: "[i:2351] [c/FF00A0:Отключить зелья телепортации]"
			Tooltip:
				'''
				Эффекты зелий телепортации заменяются на эффект зелья возврата.
				Вкл: Зелья телепортации работают как зелья возврата.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		DisallowSpawn: {
			Label: "[i:224] [c/FF00A0:Запретить цели менять точку возрождения]"
			Tooltip:
				'''
				Цель не сможет менять точку возрождения для свободной телепортации.
				Вкл: Точка возрождения цели неизменяема.
				Выкл: Применяются стандартные правила игры.
				'''
		}

		LuckBoost: {
			Label: "[i:4022] [c/FF00A0:Искусственное повышение удачи]"
			Tooltip:
				'''
				Цель получает усиление удачи.
				0.1-20: Множитель удачи.
				0: Применяются стандартные правила игры.
				'''
		}

		SpeedBoostRunner: {
			Label: "[i:54] [c/FF00A0:Ускорение движения (Спидранер)]"
			Tooltip:
				'''
				Цель получает усиление скорости движения.
				1.01-2: Множитель скорости.
				1: Применяются стандартные правила игры.
				'''
		}

		SpeedBoostHunters: {
			Label: "[i:405] [c/FF00A0:Ускорение движения (Охотники)]"
			Tooltip:
				'''
				Охотники получают усиление скорости движения.
				1.01-2: Множитель скорости.
				1: Применяются стандартные правила игры.
				'''
		}
	}
}